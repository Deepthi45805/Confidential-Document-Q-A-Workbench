# DocShield AI Configuration

# Execution Mode: "LOCAL" (uses Ollama) or "DEMO" (uses fallback rule-based AI)
EXECUTION_MODE=LOCAL

# Ollama LLM Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Embedding Model Settings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Storage Directories
DATA_DIR=data/uploads
SAMPLE_DOCS_DIR=data/sample_documents
CHROMA_PERSIST_DIR=chroma_db_store
SQLITE_DB_PATH=audit_log.db

# Vector DB Settings
COLLECTION_NAME=docshield_collection
CHUNK_SIZE=500
CHUNK_OVERLAP=50
